# Copie ce fichier en ".env" et remplis les valeurs

# Base de données PostgreSQL (Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# JWT - générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET

# OpenAI
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini

# Quotas assistant IA (DeepSeek) par compte
ASSISTANT_CHAT_DAILY_LIMIT=15
ASSISTANT_ORIENTATION_MONTHLY_LIMIT=5
